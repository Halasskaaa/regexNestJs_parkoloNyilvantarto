<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Profil szerkesztés</h1>

    <table>
        <thead>
            <tr>
                <th>Rendszám</th>
                <th>Tulajdonos</th>
                <th>Időtartam</th>
                <th>Fizetve</th>
            </tr>

        </thead>
        <tbody>
            <% parkolohelyek.forEach(parkolo => { %>
                <tr>
                    <td>
                        <%= parkolo.rendszam %>
                    </td>
                    <td>
                        <%= parkolo.tulajdonos %>
                    </td>
                    <td>
                        <%= parkolo.idotartam %>
                    </td>
                    <td>
                        <%= parkolo.fizetve %>
                    </td>
                </tr>

                <% }) %>
        </tbody>
    </table>

</body>

</html>