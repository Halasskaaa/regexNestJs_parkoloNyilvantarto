<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Profil szerkesztés
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Parkolóhely nyilvántartó</h1>

    <form action="post">
        <input type="text" name="rendszam" placeholder="Rendszám" pattern="^[a-zA-Z]{2} [a-zA-Z]{2}-[0-9]{3}$" required>
        <input type="text" name="tulajdonos" placeholder="Tulajdonos">
        <input type="number" name="idotartam" placeholder="Időtartam" min="1">
        <select name="fizetve">
            <option value="0">Yes</option>
            <option value="1">No</option>
        </select>
        <button>Hozzáadás</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>Rendszám</th>
                <th>Tulajdonos</th>
                <th>Időtartam</th>
                <th>Fizetve</th>
            </tr>

        </thead>
        <tbody>
            <% parkolohelyek.forEach(parkolo => { %>
                <tr>
                    <td>
                        <%= parkolo.rendszam %>
                    </td>
                    <td>
                        <%= parkolo.tulajdonos %>
                    </td>
                    <td>
                        <%= parkolo.idotartam %>
                    </td>
                    <td>
                        <%= parkolo.fizetve %>
                    </td>
                </tr>

                <% }) %>
        </tbody>
    </table>

</body>

</html>